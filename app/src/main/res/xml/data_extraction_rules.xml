<?xml version="1.0" encoding="utf-8"?>
<!--
    Device-to-device transfer rules (Android 12+ / API 31+).
    Same as backup rules — exclude encrypted prefs and offline maps.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="mbgl-offline.db" />
        <exclude domain="file" path="mbgl-offline/" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="mbgl-offline.db" />
        <exclude domain="file" path="mbgl-offline/" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
