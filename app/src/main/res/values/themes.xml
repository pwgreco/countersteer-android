<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Countersteer" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0A0A0A</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Countersteer.Main</item>
    </style>

    <style name="Theme.Countersteer.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF0A0A0A</item>
    </style>
</resources>
